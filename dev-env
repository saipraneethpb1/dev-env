#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
dry="0"

XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry)
            dry="1"
            ;;
        *)
            echo "unknown argument: $1" >&2
            exit 1
            ;;
    esac
    shift
done

log() {
    if [[ "$dry" == "1" ]]; then
        echo "[DRY_RUN]: $*"
    else
        echo "$*"
    fi
}

execute() {
    log "execute $*"

    if [[ "$dry" == "1" ]]; then
        return 0
    fi

    "$@"
}

die() {
    echo "dev-env: $*" >&2
    exit 1
}

copy_dir() {
    local from="$1"
    local to="$2"

    [[ -d "$from" ]] || die "expected directory: $from"
    [[ -n "$to" ]] || die "destination cannot be empty"

    execute mkdir -p "$to"

    while IFS= read -r -d '' dir; do
        local name
        name="$(basename "$dir")"

        execute rm -rf "$to/$name"
        execute cp -r "$dir" "$to/$name"
    done < <(find "$from" -mindepth 1 -maxdepth 1 -type d -print0)
}

copy_file() {
    local from="$1"
    local to="$2"
    local name

    [[ -f "$from" ]] || die "expected file: $from"
    [[ -n "$to" ]] || die "destination cannot be empty"

    name="$(basename "$from")"

    execute mkdir -p "$to"
    execute rm -f "$to/$name"
    execute cp "$from" "$to/$name"
}

cd "$script_dir"

log "------------ dev-env --------------"

copy_dir ".config" "$XDG_CONFIG_HOME"
copy_dir ".local" "$HOME/.local"
copy_file ".specialconfig" "$HOME"
