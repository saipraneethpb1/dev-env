{
    "layer": "top",
    "position": "top",
    "height": 26,

    "spacing": 0,

    "modules-left": [
        "hyprland/workspaces"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "pulseaudio",
        "battery",
        "network",
        "cpu",
        "memory",
        "custom/lock"
    ],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,

        "format": "{name}: {icon}",

        "format-icons": {
            "active": "",
            "default": "●"
        }
    },

    "clock": {
        "format": "{:%d - %H:%M}",
        "tooltip-format": "{:%A, %d %B %Y}"
    },

    "pulseaudio": {
        "format": "  {volume}%",
        "format-muted": "󰝟  mute",
        "scroll-step": 5
    },

    "battery": {
        "format": "{capacity}%  {icon}",
        "format-charging": "{capacity}%  󰂄",
        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ]
    },

    "network": {
        "format-wifi": "󰤨",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭",
        "tooltip-format-wifi": "{essid}  {signalStrength}%"
    },

    "cpu": {
        "format": "  {usage}%"
    },

    "memory": {
        "format": "  {used:0.1f}G/{total:0.1f}G"
    },

    "custom/lock": {
        "format": "",
        "on-click": "hyprlock",
        "tooltip": false
    }
}
