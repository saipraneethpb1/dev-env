#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
filter=""
dry="0"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry)
            dry="1"
            ;;
        *)
            if [[ -n "$filter" ]]; then
                echo "run: only one filter is supported" >&2
                exit 1
            fi
            filter="$1"
            ;;
    esac
    shift
done

log() {
    if [[ "$dry" == "1" ]]; then
        echo "[DRY_RUN]: $*"
    else
        echo "$*"
    fi
}

execute() {
    log "execute $*"

    if [[ "$dry" == "1" ]]; then
        return 0
    fi

    "$@"
}

cd "$script_dir"

log "$script_dir -- ${filter:-all}"

scripts=(
    base
    dev
    zsh
    tmux
    languages
    neovim
    ghostty
    hyprland
)

for name in "${scripts[@]}"; do
    script="$script_dir/runs/$name"

    if [[ -n "$filter" && "$name" != *"$filter"* ]]; then
        log "filtering $script"
        continue
    fi

    [[ -x "$script" ]] || {
        log "skipping non-executable $script"
        continue
    }

    execute "$script"
done
